{
  "name": "midnight-coffee",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "fast-glob": "file:./tools/fast-glob-shim",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
